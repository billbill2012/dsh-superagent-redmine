{
  "name": "dsh-superagent-redmine",
  "version": "0.1.0",
  "private": true,
  "description": "A DSH superagent Source plugin that turns Redmine issues and comments into Tickets, and writes results back as Redmine notes.",
  "license": "MIT",
  "author": "billlai",
  "keywords": [
    "dsh",
    "dsh-superagent",
    "deepseek-harness",
    "redmine",
    "plugin",
    "source",
    "issue-tracker",
    "typescript"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "SETUP.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "dsh-superagent": "*"
  },
  "peerDependenciesMeta": {
    "dsh-superagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.3"
  },
  "packageManager": "pnpm@11.7.0"
}
